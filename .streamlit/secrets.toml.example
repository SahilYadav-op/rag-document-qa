# Copy this file to .streamlit/secrets.toml for local runs, or paste the same lines into the
# "Secrets" box when you deploy on Streamlit Community Cloud. The real file is ignored by git.
#
# With keys here, visitors can use the app without pasting their own. Anyone who opens the
# app then spends YOUR Cohere and Pinecone quota, so keep RAG_MAX_QUESTIONS set.

COHERE_API_KEY = "paste-your-cohere-key"
PINECONE_API_KEY = "paste-your-pinecone-key"

# Optional
RAG_MAX_QUESTIONS = 20        # questions per visitor session when the built-in keys are used (0 = no limit)
# RAG_MAX_PAGES = 80
# COHERE_CHAT_MODEL = "command-r-plus-08-2024"
# PINECONE_INDEX_NAME = "rag-document-qa"
